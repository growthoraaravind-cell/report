PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/growthora
JWT_SECRET=replace_with_a_long_random_secret_before_starting
JWT_EXPIRES_IN=1d
CLIENT_ORIGINS=http://localhost:5173
# Optional comma-separated Vercel preview origins; use exact HTTPS origins, no paths.
VERCEL_PREVIEW_ORIGINS=

# Optional integrations; keep these values server-side.
PAGESPEED_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
NODE_ENV=development